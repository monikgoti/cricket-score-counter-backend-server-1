PORT=3000
MONGODB_URI=mongodb+srv://gotimonik_db_user:<db_password>@cricket-score-counter.qj2u8hp.mongodb.net/cricket-score-counter?retryWrites=true&w=majority
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_GRACE_DAYS=30
BCRYPT_SALT_ROUNDS=12
GOOGLE_CLIENT_ID=

# Sign in with Apple (iOS app). APPLE_CLIENT_ID = accepted token audiences,
# comma-separated; the first is used for Apple's token/revoke calls
# (defaults to the iOS bundle ID). The key is a "Sign in with Apple" key
# from developer.apple.com > Keys: paste the .p8 contents (literal "\n" for
# line breaks is fine). Without the key, sign-in still works but tokens
# can't be revoked on account deletion (required by App Review).
APPLE_CLIENT_ID=com.cricketscorecounter.mobile
APPLE_TEAM_ID=8A8JG3NNKM
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_DEBUG_RESPONSE=false

# Email provider 1 (used when BREVO_API_KEY is set): Brevo transactional API.
# Brevo > SMTP & API > API keys. The sender must be verified in Brevo
# (Senders, domains & dedicated IPs). Free plan: 300 emails/day.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Cricket Score Counter"

# Email provider 2 (fallback): any SMTP server via Nodemailer, e.g. Gmail +
# an App Password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cricket Score Counter <your-gmail@gmail.com>"
EMAIL_OTP_EXPIRES_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_SENDS_PER_HOUR=5

# Mobile-number login code delivery:
#   SMS_DELIVERY=direct  -> no SMS is sent; the code is returned to the app,
#                           which fills it in. (Anyone can log in to any
#                           registered number in this mode.)
#   SMS_DELIVERY=brevo   -> real SMS via Brevo (needs the settings below).
SMS_DELIVERY=direct

# SMS for mobile-number login (Brevo transactional SMS, uses BREVO_API_KEY).
# Needs Brevo SMS credits and an approved sender. For Indian numbers the
# sender and the template text must also be registered on DLT.
BREVO_SMS_SENDER=
BREVO_SMS_TEMPLATE="{code} is your Cricket Score Counter code. It expires in {minutes} minutes. Do not share it."
BREVO_SMS_ORGANISATION_PREFIX=
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
